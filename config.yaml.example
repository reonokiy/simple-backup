# Simple Backup Configuration File (YAML)
# Copy this file to config.yaml and customize for your needs

source_path: /path/to/backup

cron_schedule: ""

compression: tar.zst

archive_name: ""

retention:
  max_backups: 0
  daily: 7
  weekly: 4
  monthly: 6
  yearly: 2

encryption:
  enabled: false
  recipient: ""
  identity: ""

# Multiple Destinations Configuration (New Format)
# You can backup to multiple destinations simultaneously
destinations:
  - service: s3
    root: backups/
    storage:
      bucket: my-primary-bucket
      region: us-east-1
      access_key_id: AKIAxxxxx
      secret_access_key: xxxxx
  
  - service: s3
    root: backups/
    storage:
      bucket: my-secondary-bucket
      region: us-west-2
      access_key_id: AKIAyyyyy
      secret_access_key: yyyyy
      endpoint: https://s3-compatible.example.com

# Single Destination Configuration (Legacy Format - Still Supported)
# Uncomment these if you want to use the legacy single destination format
# Note: If both formats are present, 'destinations' takes precedence

# dest_service: s3
# dest_root: backups/

# Storage Configuration (for legacy single destination)
# You can either set storage config here OR use OPENDAL_* environment variables
# OPENDAL_* environment variables take precedence over values here

# Example for S3:
# storage:
#   bucket: my-backup-bucket
#   region: us-east-1
#   access_key_id: AKIAxxxxx
#   secret_access_key: xxxxx
#   endpoint: ""  # optional, for S3-compatible services

# Example for Azure Blob:
# storage:
#   container: my-backups
#   account_name: myaccount
#   account_key: xxxxx

# Example for Google Cloud Storage:
# storage:
#   bucket: my-backup-bucket
#   credential: /path/to/service-account.json

# Example for local filesystem:
# storage:
#   root: /mnt/backups
