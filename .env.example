# Backup Configuration
BACKUP_SOURCE_PATH=/data
BACKUP_DEST_SERVICE=fs
BACKUP_DEST_ROOT=/backups
BACKUP_COMPRESSION=tar.zst
BACKUP_ARCHIVE_NAME=

# Scheduling (optional)
# Run daily at 2 AM
BACKUP_CRON_SCHEDULE=0 2 * * *

# Retention Policy (optional)
BACKUP_RETENTION_MAX_BACKUPS=0
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_RETENTION_YEARLY=2

# Encryption (optional)
# Enable age encryption for backup archives
BACKUP_ENCRYPTION_ENABLED=false
# Public key for encryption (age1... format)
BACKUP_ENCRYPTION_RECIPIENT=
# Private key path for decryption (optional, only needed for restore)
BACKUP_ENCRYPTION_IDENTITY=

# Storage Service Configuration
# For local filesystem
FS_ROOT=/backups

# For AWS S3 (uncomment to use)
# BACKUP_DEST_SERVICE=s3
# S3_BUCKET=my-backup-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_ENDPOINT=

# For Azure Blob Storage (uncomment to use)
# BACKUP_DEST_SERVICE=azblob
# AZURE_CONTAINER=my-backup-container
# AZURE_ACCOUNT_NAME=your-account-name
# AZURE_ACCOUNT_KEY=your-account-key

# For Google Cloud Storage (uncomment to use)
# BACKUP_DEST_SERVICE=gcs
# GCS_BUCKET=my-backup-bucket
# GCS_CREDENTIAL=your-credential-json

# For Alibaba Cloud OSS (uncomment to use)
# BACKUP_DEST_SERVICE=oss
# OSS_BUCKET=my-backup-bucket
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=your-access-key
# OSS_ACCESS_KEY_SECRET=your-secret-key

# For Huawei Cloud OBS (uncomment to use)
# BACKUP_DEST_SERVICE=obs
# OBS_BUCKET=my-backup-bucket
# OBS_ENDPOINT=obs.cn-north-4.myhuaweicloud.com
# OBS_ACCESS_KEY_ID=your-access-key
# OBS_SECRET_ACCESS_KEY=your-secret-key

# For Tencent Cloud COS (uncomment to use)
# BACKUP_DEST_SERVICE=cos
# COS_BUCKET=my-backup-bucket
# COS_REGION=ap-guangzhou
# COS_SECRET_ID=your-secret-id
# COS_SECRET_KEY=your-secret-key

# For WebDAV (uncomment to use)
# BACKUP_DEST_SERVICE=webdav
# WEBDAV_ENDPOINT=https://webdav.example.com
# WEBDAV_USERNAME=your-username
# WEBDAV_PASSWORD=your-password
